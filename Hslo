-- Logic variables
local altSkyActive = false
local ALT_HEIGHT = 60000
local altPlatform = nil

skyModeBtn.MouseButton1Click:Connect(function()
    altSkyActive = not altSkyActive
    if altSkyActive then
        skyModeBtn.Text = "Alt Sky Mode (60k): ON"
        skyModeBtn.BackgroundColor3 = Color3.fromRGB(40, 180, 40)
        
        if not altPlatform then
            altPlatform = Instance.new("Part")
            altPlatform.Name = "AltSkyPlatform"
            altPlatform.Size = Vector3.new(40, 2, 40)
            altPlatform.Position = Vector3.new(0, ALT_HEIGHT, 0)
            altPlatform.Anchored = true
            altPlatform.Transparency = 0.4
            altPlatform.Parent = Workspace
        end
        
        if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            LocalPlayer.Character.HumanoidRootPart.CFrame = CFrame.new(0, ALT_HEIGHT + 5, 0)
        end
        statusLabel.Text = "Status: Alt secured in sky platform."
    else
        skyModeBtn.Text = "Alt Sky Mode (60k): OFF"
        skyModeBtn.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
        if altPlatform then
            altPlatform:Destroy()
            altPlatform = nil
        end
        statusLabel.Text = "Status: Sky mode turned off."
    end
end)

-- Maintain alt altitude if sky mode is on
task.spawn(function()
    while true do
        task.wait(1)
        if altSkyActive and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            local root = LocalPlayer.Character.HumanoidRootPart
            if root.Position.Y < (ALT_HEIGHT - 100) then
                root.CFrame = CFrame.new(0, ALT_HEIGHT + 5, 0)
            end
        end
    end
end)

-- Helper to find player by partial name
local function getPlayer(nameInput)
    if nameInput == "" then return nil end
    nameInput = nameInput:lower()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            if player.Name:lower():sub(1, #nameInput) == nameInput or player.DisplayName:lower():sub(1, #nameInput) == nameInput then
                return player
            end
        end
    end
    return nil
end

-- Auto-sync loop: Follows the main player closely or positions for the farm
task.spawn(function()
    while true do
        task.wait(0.5)
        pcall(function()
            local mainPlayer = getPlayer(mainUserBox.Text)
            if mainPlayer and mainPlayer.Character and LocalPlayer.Character then
                local mainRoot = mainPlayer.Character:FindFirstChild("HumanoidRootPart")
                local myRoot = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                
                if mainRoot and myRoot and not altSkyActive then
                    -- Position Alt directly facing the main account's incoming hits
                    local desiredCFrame = mainRoot.CFrame * CFrame.new(0, 0, -3)
                    myRoot.CFrame = desiredCFrame
                    myRoot.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                    statusLabel.Text = "Status: Synced with Main (" .. mainPlayer.Name .. ")"
                end
            end
        end)
    end
end)

