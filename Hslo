-- Services
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local VirtualUser = game:GetService("VirtualUser")
local LocalPlayer = Players.LocalPlayer

local ALT_HEIGHT = 60000
local safetyPlatform = nil

-- Anti-AFK Protection
LocalPlayer.Idled:Connect(function()
    VirtualUser:Button2Down(Vector2.new(0,0), Workspace.CurrentCamera.CFrame)
    task.wait(1)
    VirtualUser:Button2Up(Vector2.new(0,0), Workspace.CurrentCamera.CFrame)
end)

-- Build safety platform high in the sky
local function createPlatform()
    if not safetyPlatform then
        safetyPlatform = Instance.new("Part")
        safetyPlatform.Name = "AltSafetyPlatform"
        safetyPlatform.Size = Vector3.new(50, 2, 50)
        safetyPlatform.Position = Vector3.new(0, ALT_HEIGHT, 0)
        safetyPlatform.Anchored = true
        safetyPlatform.Transparency = 0.4
        safetyPlatform.Parent = Workspace
    end
end

createPlatform()

local function setupAlt(character)
    local root = character:WaitForChild("HumanoidRootPart", 5)
    if root then
        task.wait(0.5)
        root.CFrame = CFrame.new(0, ALT_HEIGHT + 5, 0)
    end
end

if LocalPlayer.Character then
    setupAlt(LocalPlayer.Character)
end

LocalPlayer.CharacterAdded:Connect(setupAlt)

-- Alt Background Loop: Sky Platform Recovery & Main Sync
task.spawn(function()
    local ragdollCooldown = 0
    
    while true do
        task.wait(0.05)
        local myChar = LocalPlayer.Character
        if myChar and myChar:FindFirstChild("HumanoidRootPart") then
            local root = myChar.HumanoidRootPart
            local humanoid = myChar:FindFirstChildOfClass("Humanoid")
            
            -- Check for ragdoll, low health, or extreme knockback velocity
            local isRagdolled = false
            if humanoid and (humanoid.PlatformStand or myChar:FindFirstChild("Ragdoll") or humanoid.Health <= 0) then
                isRagdolled = true
            end
            
            if isRagdolled or root.AssemblyLinearVelocity.Magnitude > 100 then
                ragdollCooldown = tick() + 1.5 -- Lock recovery for 1.5 seconds on the sky platform
                root.CFrame = CFrame.new(0, ALT_HEIGHT + 5, 0)
                root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            elseif tick() < ragdollCooldown then
                root.CFrame = CFrame.new(0, ALT_HEIGHT + 5, 0)
                root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            else
                -- Check if main player is active
                local foundActiveMain = false
                for _, player in ipairs(Players:GetPlayers()) do
                    if player ~= LocalPlayer and player.Character then
                        if player.Character:FindFirstChild("DualFarmActiveTag") then
                            foundActiveMain = true
                            local mainRoot = player.Character:FindFirstChild("HumanoidRootPart")
                            if mainRoot then
                                root.CFrame = mainRoot.CFrame * CFrame.new(0, 0, -3)
                                root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                            end
                            break
                        end
                    end
                end
                
                -- If no main is active, stay safe on the sky platform
                if not foundActiveMain then
                    if root.Position.Y < (ALT_HEIGHT - 100) then
                        root.CFrame = CFrame.new(0, ALT_HEIGHT + 5, 0)
                        root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                    end
                end
            end
        end
    end
end)
