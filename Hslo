local notifiedGloves = {}

local function refreshGloveList()
    for _, child in ipairs(scrollFrame:GetChildren()) do
        if child:IsA("TextLabel") then
            child:Destroy()
        end
    end
    
    local leaderstats = LocalPlayer:FindFirstChild("leaderstats")
    local currentSlaps = leaderstats and leaderstats:FindFirstChild("Slaps") and leaderstats.Slaps.Value or 0
    local query = searchBox.Text:lower()
    
    for _, glove in ipairs(gloveMilestones) do
        if query == "" or glove.name:lower():find(query) then
            local isUnlocked = currentSlaps >= glove.cost
            
            local itemLabel = Instance.new("TextLabel", scrollFrame)
            itemLabel.Size = UDim2.new(1, -5, 0, 24)
            itemLabel.BackgroundTransparency = 0.8
            itemLabel.BackgroundColor3 = isUnlocked and Color3.fromRGB(40, 100, 40) or Color3.fromRGB(100, 40, 40)
            itemLabel.Font = Enum.Font.Gotham
            itemLabel.TextSize = 11
            itemLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
            itemLabel.TextXAlignment = Enum.TextXAlignment.Left
            
            if isUnlocked then
                itemLabel.Text = "  [OWNED] " .. glove.name .. " (" .. glove.cost .. " slaps)"
            else
                itemLabel.Text = "  [LOCKED] " .. glove.name .. " (" .. glove.cost .. " slaps)"
            end
            
            Instance.new("UICorner", itemLabel).CornerRadius = UDim.new(0, 4)
        end
    end
end

searchBox:GetPropertyChangedSignal("Text"):Connect(refreshGloveList)

task.spawn(function()
    local leaderstats = LocalPlayer:WaitForChild("leaderstats", 10)
    if leaderstats then
        local slapsVal = leaderstats:WaitForChild("Slaps", 10)
        if slapsVal then
            for _, glove in ipairs(gloveMilestones) do
                if slapsVal.Value >= glove.cost then
                    notifiedGloves[glove.name] = true
                end
            end
        end
    end
    refreshGloveList()
    
    while true do
        task.wait(1)
        refreshGloveList()
        local leaderstats = LocalPlayer:FindFirstChild("leaderstats")
        if leaderstats then
            local slapsVal = leaderstats:FindFirstChild("Slaps")
            if slapsVal then
                local currentSlaps = slapsVal.Value
                for _, glove in ipairs(gloveMilestones) do
                    if not notifiedGloves[glove.name] and currentSlaps >= glove.cost then
                        notifiedGloves[glove.name] = true
                        StarterGui:SetCore("SendNotification", {
                            Title = "🎉 Glove Unlocked!",
                            Text = "You reached " .. currentSlaps .. " slaps and can now get '" .. glove.name .. "' (" .. glove.cost .. " slaps)!",
                            Duration = 7
                        })
                    end
                end
            end
        end
    end
end)

local function getTargetPlayer(nameInput)
    nameInput = nameInput:lower()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            if player.Name:lower():sub(1, #nameInput) == nameInput or player.DisplayName:lower():sub(1, #nameInput) == nameInput then
                return player
            end
        end
    end
    return nil
end

