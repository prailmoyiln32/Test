-- Services
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local VirtualInputManager = game:GetService("VirtualInputManager")
local StarterGui = game:GetService("StarterGui")
local LocalPlayer = Players.LocalPlayer

-- Anti-AFK Connection for Alt
LocalPlayer.Idled:Connect(function()
    VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
    task.wait(0.05)
    VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
end)

-- Notification
StarterGui:SetCore("SendNotification", {
    Title = "Alt Account Ready",
    Text = "Anti-AFK active. Waiting for Main account...",
    Duration = 5
})

-- Auto-response check for Dual Farm tag from Main
task.spawn(function()
    while true do
        task.wait(2)
        pcall(function()
            for _, player in ipairs(Players:GetPlayers()) do
                if player ~= LocalPlayer and player.Character then
                    if player.Character:FindFirstChild("DualFarmActiveTag") then
                        -- Touch or interact with the dual table if close by
                        local dualPart = Workspace.Lobby.Dual
                        local cd = dualPart:FindFirstChildOfClass("ClickDetector")
                        if cd then
                            fireclickdetector(cd)
                        end
                    end
                end
            end
        end
    end
end)
