-- Services
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local VirtualInputManager = game:GetService("VirtualInputManager")
local StarterGui = game:GetService("StarterGui")
local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

-- Anti-AFK Connection
LocalPlayer.Idled:Connect(function()
    VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
    task.wait(0.05)
    VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
end)

-- Cleanup existing GUI if running again
if PlayerGui:FindFirstChild("DualFarmAltHub") then
    PlayerGui.DualFarmAltHub:Destroy()
end

-- Create Alt Hub GUI Frame
local screenGui = Instance.new("ScreenGui", PlayerGui)
screenGui.Name = "DualFarmAltHub"
screenGui.ResetOnSpawn = false

local mainFrame = Instance.new("Frame", screenGui)
mainFrame.Size = UDim2.new(0, 260, 0, 160)
mainFrame.Position = UDim2.new(0.5, -130, 0.2, 0)
mainFrame.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
mainFrame.Active = true
mainFrame.Draggable = true
Instance.new("UICorner", mainFrame).CornerRadius = UDim.new(0, 10)

local uiStroke = Instance.new("UIStroke", mainFrame)
uiStroke.Color = Color3.fromRGB(60, 60, 60)
uiStroke.Thickness = 2

-- Title Bar
local title = Instance.new("TextLabel", mainFrame)
title.Size = UDim2.new(1, 0, 0, 30)
title.Text = "Slap Battles Hub (Alt)"
title.TextColor3 = Color3.fromRGB(255, 255, 255)
title.Font = Enum.Font.GothamBold
title.TextSize = 13
title.BackgroundTransparency = 1

-- Status Label
local statusLabel = Instance.new("TextLabel", mainFrame)
statusLabel.Size = UDim2.new(0.9, 0, 0, 40)
statusLabel.Position = UDim2.new(0.05, 0, 0, 30)
statusLabel.Text = "Status: Ready. Click Alt Sky Mode to lock-in."
statusLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
statusLabel.Font = Enum.Font.Gotham
statusLabel.TextSize = 11
statusLabel.BackgroundTransparency = 1
statusLabel.TextWrapped = true

-- Toggle for Alt Sky Mode
local skyModeBtn = Instance.new("TextButton", mainFrame)
skyModeBtn.Size = UDim2.new(0.9, 0, 0, 32)
skyModeBtn.Position = UDim2.new(0.05, 0, 0, 80)
skyModeBtn.Text = "Alt Sky Mode (60k): OFF"
skyModeBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
skyModeBtn.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
skyModeBtn.Font = Enum.Font.GothamBold
skyModeBtn.TextSize = 11
Instance.new("UICorner", skyModeBtn).CornerRadius = UDim.new(0, 6)

-- Footer note
local footer = Instance.new("TextLabel", mainFrame)
footer.Size = UDim2.new(1, 0, 0, 20)
footer.Position = UDim2.new(0, 0, 1, -20)
footer.Text = "Anti-AFK & Strict Platform Lock"
footer.TextColor3 = Color3.fromRGB(100, 220, 100)
footer.Font = Enum.Font.Gotham
footer.TextSize = 10
footer.BackgroundTransparency = 1

-- Logic variables
local altSkyActive = false
local ALT_HEIGHT = 60000
local altPlatform = nil

skyModeBtn.MouseButton1Click:Connect(function()
    altSkyActive = not altSkyActive
    if altSkyActive then
        skyModeBtn.Text = "Alt Sky Mode (60k): ON"
        skyModeBtn.BackgroundColor3 = Color3.fromRGB(40, 180, 40)
        statusLabel.Text = "Status: Locked & spam-teleporting on platform!"
    else
        skyModeBtn.Text = "Alt Sky Mode (60k): OFF"
        skyModeBtn.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
        
        if altPlatform then
            altPlatform:Destroy()
            altPlatform = nil
        end
        statusLabel.Text = "Status: Sky mode turned off."
    end
end)

-- Aggressive Platform Maintenance & Strict Spam-Teleport Lock Loop
task.spawn(function()
    while true do
        task.wait(0.05) -- Hyper-fast check to spam-teleport instantly every frame
        if altSkyActive then
            -- Ensure the Alt's private platform always exists
            if not altPlatform or not altPlatform.Parent then
                altPlatform = Instance.new("Part")
                altPlatform.Name = "PrivateAltPlatform"
                altPlatform.Size = Vector3.new(50, 2, 50)
                altPlatform.Position = Vector3.new(0, ALT_HEIGHT, 0)
                altPlatform.Anchored = true
                altPlatform.Transparency = 0.3
                altPlatform.BrickColor = BrickColor.new("Really black")
                altPlatform.Parent = Workspace
            end
            
            -- Continuously spam-teleport Alt directly onto the platform center so it cannot move or fall freely
            local char = LocalPlayer.Character
            if char then
                local root = char:FindFirstChild("HumanoidRootPart")
                if root then
                    root.CFrame = CFrame.new(0, ALT_HEIGHT + 5, 0)
                    root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                end
            end
        end
    end
end)

StarterGui:SetCore("SendNotification", {
    Title = "Alt Hub Loaded",
    Text = "Turn on Alt Sky Mode to lock and spam-teleport onto its platform.",
    Duration = 5
})
