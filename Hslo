footer.TextColor3 = Color3.fromRGB(100, 220, 100)
footer.Font = Enum.Font.Gotham
footer.TextSize = 10
footer.BackgroundTransparency = 1

-- Logic variables
local altSkyActive = false
local ALT_HEIGHT = 60000
local altPlatform = nil

skyModeBtn.MouseButton1Click:Connect(function()
    altSkyActive = not altSkyActive
    if altSkyActive then
        skyModeBtn.Text = "Alt Sky Mode (60k): ON"
        skyModeBtn.BackgroundColor3 = Color3.fromRGB(40, 180, 40)
        
        if not altPlatform then
            altPlatform = Instance.new("Part")
            altPlatform.Name = "AltSkyPlatform"
            altPlatform.Size = Vector3.new(40, 2, 40)
            altPlatform.Position = Vector3.new(0, ALT_HEIGHT, 0)
            altPlatform.Anchored = true
            altPlatform.Transparency = 0.4
            altPlatform.Parent = Workspace
        end
        
        if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            LocalPlayer.Character.HumanoidRootPart.CFrame = CFrame.new(0, ALT_HEIGHT + 5, 0)
        end
        statusLabel.Text = "Status: Alt secured in sky platform."
    else
        skyModeBtn.Text = "Alt Sky Mode (60k): OFF"
        skyModeBtn.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
        if altPlatform then
            altPlatform:Destroy()
            altPlatform = nil
        end
        statusLabel.Text = "Status: Sky mode turned off."
    end
end)

-- Maintain alt altitude if sky mode is on
task.spawn(function()
    while true do
        task.wait(1)
        if altSkyActive and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            local root = LocalPlayer.Character.HumanoidRootPart
            if root.Position.Y < (ALT_HEIGHT - 100) then
                root.CFrame = CFrame.new(0, ALT_HEIGHT + 5, 0)
            end
        end
    end
end)

-- Auto-response check for Main account Dual Farm signal
task.spawn(function()
    while true do
        task.wait(2)
        pcall(function()
            for _, player in ipairs(Players:GetPlayers()) do
                if player ~= LocalPlayer and player.Character then
                    if player.Character:FindFirstChild("DualFarmActiveTag") then
                        statusLabel.Text = "Status: Connected to Main (" .. player.Name .. ")"
                        local dualPart = Workspace.Lobby.Dual
                        local cd = dualPart:FindFirstChildOfClass("ClickDetector")
                        if cd then
                            fireclickdetector(cd)
                        end
                    end
                end
            end
        end)
    end
end)

StarterGui:SetCore("SendNotification", {
    Title = "Alt Hub Loaded",
    Text = "Anti-AFK and Auto-Receiver are running.",
    Duration = 5
})
